# =============================================================================
# Gemvox Repository & Global GitIgnore Configuration
# Prevents non-code files, secrets, build artifacts, and user media from leaking
# =============================================================================

# --- 1. Secrets, API Keys & Local User Configuration ---
.env
.env.*
!.env.example
config.json
config.json.bak
config.json.tmp
portable.txt
*.key
*.pem
secrets.*

# --- 2. Python Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- 3. Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- 4. PyInstaller & Packaging Build Artifacts ---
build/
dist/
*.manifest
*.exe
*.msi
*.zip
*.7z
*.rar
*.tar.gz

# Keep required screen reader DLLs inside gemvox/accessibility/lib/, ignore stray root DLLs
/*.dll
!gemvox/accessibility/lib/*.dll

# --- 5. Generated Audio, Test Media & User Output ---
output/
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.wma
*.mp4
*.mkv
*.avi
*.mov

# --- 6. Office Documents, Presentations & Scratch Files ---
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.xls
*.pdf
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# --- 7. IDEs, Editors & AI Assistants ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
.antigravity/
.cursor/
.claude/

# --- 8. OS-Generated & Log Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.log
*.pid
*.seed
*.pid.lock

# --- 9. Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
